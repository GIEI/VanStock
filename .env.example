DB_NAME=stocksimple
DB_USER=stockuser
DB_PASSWORD=stockpass
JWT_SECRET=change_this_to_a_secure_random_string
APP_ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:4200

# First-run administrator. Change these before using a non-development environment.
DEFAULT_COMPANY_NAME=Example Company
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASS=change_this_password_before_first_start

# Optional Firebase service account JSON for Android push notifications.
# Keep the real value outside version control.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Email (opzionale) — usata per notifiche di richiesta rifornimento
# Lascia vuoto per disabilitare l'invio email (la richiesta viene solo loggata nel backend)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=yourpassword
SMTP_FROM=VanStock <noreply@example.com>
